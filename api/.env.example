# Postgres URL used by the API (host port 5433 maps to the compose db)
DATABASE_URL=postgresql+psycopg://credisure:credisure@localhost:5433/credisure
# Postgres URL used by pytest
TEST_DATABASE_URL=postgresql+psycopg://credisure:credisure@localhost:5433/credisure_test
# Secret used to sign JWTs. Use a long random value outside local development.
JWT_SECRET=dev-only-change-me
# Token lifetime in minutes
JWT_TTL_MINUTES=60
# Allowed browser origins: a JSON list or a comma-separated string
CORS_ORIGINS=["http://localhost:3000"]
# local | test | prod
ENV=local
# Run the background provider pinger (Phase 4)
PINGER_ENABLED=true
# bcrypt cost factor for password hashing (tests lower it for speed)
BCRYPT_ROUNDS=12
